---
import '../styles/global.css';
const apiBase = import.meta.env.PUBLIC_API_BASE || '';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const nav = [
  ['Home', '#home'], ['Projects', '#projects'], ['Tools', '#tools'],
  ['Free Resources', '#resources'], ['About', '#about'], ['Contact', '#contact'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eef2f5" />
    <meta name="description" content="John Mark Fuentes is a junior web developer building thoughtful, responsive web experiences." />
    <title>John Mark Fuentes — Junior Web Developer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="site-shell">
      <aside class="sidebar" aria-label="Portfolio sidebar">
        <a class="brand-mark" href="#home" aria-label="John Mark Fuentes home">JM<span>.</span></a>
        <div class="profile-photo-wrap">
          <img class="profile-photo" src={`${base}images/john-mark-fuentes.jpg`} alt="John Mark Fuentes outdoors" />
          <span class="availability"><i></i> Open to opportunities</span>
        </div>
        <div class="profile-copy">
          <p class="eyebrow">PORTFOLIO · 2026</p>
          <h1>John Mark<br />Fuentes</h1>
          <p class="role">Junior Web Developer</p>
          <p class="intro">I build thoughtful, responsive websites and keep learning through every project. Open to opportunities to grow and create useful experiences.</p>
        </div>
        <div class="visit-line" aria-live="polite"><span class="visit-dot"></span><span id="visit-count">Visits loading</span></div>
        <div class="social-row" aria-label="Social links will be added later">
          <span class="social-placeholder"></span>
          <span class="social-placeholder"></span>
          <span class="social-placeholder"></span>
        </div>
        <nav class="side-nav" aria-label="Main navigation">
          {nav.map(([label, href], i) => <a class:list={['nav-link', i === 0 && 'active']} href={href}><span class="nav-number">0{i + 1}</span>{label}<span class="nav-arrow">↗</span></a>)}
        </nav>
        <div class="sidebar-bottom"><span class="mini-orbit">✳</span><span>Thoughtful by design.<br />Built to keep getting better.</span></div>
      </aside>

      <main class="main-content">
        <section class="hero section" id="home">
          <div class="hero-topline"><span class="eyebrow">HELLO, I'M JOHN MARK</span><span class="hero-location">Based in the Philippines <span class="location-dot"></span></span></div>
          <div class="hero-copy">
            <h2>Making the web<br />feel <span class="accent-word">useful.</span></h2>
            <p class="hero-description">I’m a junior web developer who enjoys turning ideas into clear, welcoming digital experiences. I’m building my skills one thoughtful project at a time.</p>
            <div class="hero-actions"><a class="button button-primary" href="#projects">Explore my work <span>↘</span></a><a class="text-link" href="#contact">Let’s talk <span>↗</span></a></div>
          </div>
          <div class="hero-footer"><span class="scroll-cue"><span class="scroll-line"></span> SCROLL TO EXPLORE</span><span class="hero-note">DESIGNING · BUILDING · LEARNING</span></div>
          <div class="hero-decoration" aria-hidden="true"><span>J</span><span>M</span><b>✳</b></div>
        </section>

        <section class="section work-section" id="projects">
          <div class="section-heading"><div><p class="eyebrow">SELECTED WORK</p><h2>Projects <span class="heading-count">(in progress)</span></h2></div><p class="section-blurb">A home for the work I’m proud to share. More projects will appear here as I build them.</p></div>
          <div class="empty-projects"><div class="empty-illustration" aria-hidden="true"><span class="browser-bar"><i></i><i></i><i></i></span><span class="browser-block block-one"></span><span class="browser-block block-two"></span><span class="browser-line"></span></div><div><p class="eyebrow">THE FIRST ONES ARE TAKING SHAPE</p><h3>Good work takes a first step.</h3><p>Project previews and details will be added here when they’re ready to share.</p></div><span class="empty-index">01—</span></div>
        </section>

        <section class="section tools-section" id="tools">
          <div class="section-heading"><div><p class="eyebrow">MY WORKBENCH</p><h2>Tools I work with</h2></div><p class="section-blurb">The tools and technologies I use will live here.</p></div>
          <div class="quiet-empty"><span class="quiet-icon">＋</span><span>Tools will be added soon</span><span class="quiet-rule"></span><span class="eyebrow">A WORK IN PROGRESS</span></div>
        </section>

        <section class="resources-section section" id="resources">
          <div class="section-heading"><div><p class="eyebrow">MADE TO BE SHARED</p><h2>Free resources</h2></div><p class="section-blurb">A collection of useful things I create and share freely.</p></div>
          <div class="resource-empty"><div class="resource-star">✳</div><div><h3>A little something, soon.</h3><p>This space is ready for the resources and tools I choose to share.</p></div><span class="resource-empty-tag">EMPTY BY DESIGN</span></div>
        </section>

        <section class="about-section section" id="about">
          <div class="section-heading"><div><p class="eyebrow">A LITTLE ABOUT ME</p><h2>Curious by nature.<br /><span class="muted-heading">Developer in progress.</span></h2></div></div>
          <div class="about-grid"><p class="about-lead">I’m John Mark, a junior web developer who likes bringing structure and care to the way things work online.</p><div class="about-details"><p>I’m growing my skills through hands-on projects and learning as I go. I value clear layouts, useful details, and experiences that feel good to use.</p><p>This portfolio will grow with me—one project, lesson, and idea at a time.</p><a class="text-link" href="#contact">Have a project in mind? <span>↗</span></a></div></div>
        </section>

        <section class="contact-section section" id="contact">
          <div class="section-heading"><div><p class="eyebrow">CONTACT</p><h2>Let’s make something<br /><span class="muted-heading">worth opening.</span></h2></div><p class="section-blurb">Have an opportunity or idea? Send me a message and let’s start a conversation.</p></div>
          <div class="contact-grid">
            <div class="contact-aside"><span class="contact-glyph">↗</span><p class="eyebrow">SAY HELLO</p><h3>Good things<br />start with a note.</h3><p>I’m open to hearing about projects, opportunities, and ways to grow.</p><a class="email-link" href="mailto:johnmarkfuentes8@gmail.com">johnmarkfuentes8@gmail.com <span>↗</span></a><div class="contact-aside-foot"><span class="location-dot"></span> Usually replies within a few days</div></div>
            <form class="contact-form" id="contact-form" data-api-base={apiBase} novalidate>
              <div class="form-heading"><div><p class="eyebrow">YOUR MESSAGE</p><h3>Tell me what’s on your mind.</h3></div><span class="form-step" id="form-step-label">STEP 01 / 02</span></div>
              <div id="message-fields">
                <div class="form-row"><label>YOUR NAME<input name="name" autocomplete="name" required maxlength="90" placeholder="How should I address you?" /></label><label>YOUR EMAIL<input name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.com" /></label></div>
                <label>SUBJECT<input name="subject" required maxlength="120" placeholder="What would you like to talk about?" /></label>
                <label>YOUR MESSAGE<textarea name="message" required minlength="10" maxlength="3000" rows="5" placeholder="Share a little about your idea or opportunity…"></textarea></label>
                <div class="form-submit-row"><button class="button button-primary" type="submit">Verify email to continue <span>→</span></button><span class="privacy-note">I’ll verify your email before your message is sent.</span></div>
              </div>
              <div id="verification-fields" hidden>
                <label>VERIFICATION CODE<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="Enter the 6-digit code" /></label>
                <p class="verify-explainer">Check your inbox for a one-time code. Your message will only be sent after the code is verified.</p>
                <div class="form-submit-row"><button class="button button-primary" type="button" id="verify-button">Verify and send <span>→</span></button><button class="resend-button" type="button" id="resend-button">Send a new code</button></div>
              </div>
              <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
              <div class="form-bottom"><span><i></i> No newsletter. No spam.</span><span>YOUR DETAILS STAY PRIVATE</span></div>
            </form>
          </div>
        </section>
        <footer class="footer"><span>© 2026 John Mark Fuentes</span><span>Made with care <b>✳</b></span><a href="#home">Back to top ↑</a></footer>
      </main>
    </div>

    <button class="floating-message" id="message-button" aria-label="Open contact form"><span class="message-icon">✉</span><span>Message me</span><span class="button-arrow">↗</span></button>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script define:vars={{ apiBase }}>
      const counter = document.querySelector('#visit-count');
      if (!apiBase) counter.textContent = 'Visit count setup pending';
      else {
        const countVisits = async () => {
          try {
            const headers = { 'Content-Type': 'application/json' };
            const seen = sessionStorage.getItem('portfolio-visit-recorded');
            if (!seen) {
              await fetch(`${apiBase}/visits`, { method: 'POST', headers, body: JSON.stringify({ path: location.pathname }) });
              sessionStorage.setItem('portfolio-visit-recorded', 'yes');
            }
            const response = await fetch(`${apiBase}/visits`);
            if (!response.ok) throw new Error('Counter unavailable');
            const data = await response.json();
            counter.textContent = `${Number(data.visits).toLocaleString()} visits`;
          } catch { counter.textContent = 'Visit count unavailable'; }
        };
        countVisits();
      }

      const form = document.querySelector('#contact-form');
      const status = document.querySelector('#form-status');
      const messageFields = document.querySelector('#message-fields');
      const verifyFields = document.querySelector('#verification-fields');
      const stepLabel = document.querySelector('#form-step-label');
      const toast = document.querySelector('#toast');
      let pendingMessage = null;
      const setStatus = (message, kind = '') => { status.textContent = message; status.dataset.kind = kind; };
      const startVerification = async () => {
        if (!form.reportValidity()) return;
        if (!apiBase) { setStatus('Email verification is not connected yet. Please email me directly at johnmarkfuentes8@gmail.com.', 'error'); return; }
        const values = Object.fromEntries(new FormData(form).entries());
        pendingMessage = { name: values.name, email: values.email, subject: values.subject, message: values.message };
        const button = form.querySelector('[type="submit"]'); button.disabled = true; setStatus('Sending a verification code…');
        try {
          const response = await fetch(`${apiBase}/contact/start`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(pendingMessage) });
          const data = await response.json(); if (!response.ok) throw new Error(data.error || 'Could not send a verification code.');
          messageFields.hidden = true; verifyFields.hidden = false; stepLabel.textContent = 'STEP 02 / 02'; setStatus(data.message || 'Verification code sent. Check your email.', 'success');
          verifyFields.querySelector('[name="code"]').focus();
        } catch (error) { setStatus(error.message || 'Could not send the code. Please try again.', 'error'); }
        finally { button.disabled = false; }
      };
      const sendVerifiedMessage = async () => {
        const codeInput = verifyFields.querySelector('[name="code"]');
        if (!/^\d{6}$/.test(codeInput.value)) { codeInput.setCustomValidity('Enter the 6-digit code from your email.'); codeInput.reportValidity(); codeInput.setCustomValidity(''); return; }
        const button = document.querySelector('#verify-button'); button.disabled = true; setStatus('Checking your code and sending the message…');
        try {
          const response = await fetch(`${apiBase}/contact/verify`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...pendingMessage, code: codeInput.value }) });
          const data = await response.json(); if (!response.ok) throw new Error(data.error || 'The code could not be verified.');
          form.reset(); pendingMessage = null; messageFields.hidden = false; verifyFields.hidden = true; stepLabel.textContent = 'STEP 01 / 02'; setStatus(data.message || 'Email verified—your message has been sent. Thank you!', 'success');
        } catch (error) { setStatus(error.message || 'Could not verify the code. Please try again.', 'error'); }
        finally { button.disabled = false; }
      };
      form.addEventListener('submit', event => { event.preventDefault(); startVerification(); });
      document.querySelector('#verify-button').addEventListener('click', sendVerifiedMessage);
      document.querySelector('#resend-button').addEventListener('click', startVerification);
      document.querySelector('#message-button').addEventListener('click', () => { document.querySelector('#contact').scrollIntoView({ behavior: 'smooth' }); setTimeout(() => form.querySelector('[name="name"]').focus(), 450); });
      const links = document.querySelectorAll('.nav-link');
      const sections = [...document.querySelectorAll('main section[id]')];
      const observer = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) links.forEach(link => link.classList.toggle('active', link.hash === `#${entry.target.id}`)); }), { rootMargin: '-35% 0px -55% 0px' });
      sections.forEach(section => observer.observe(section));
      document.querySelectorAll('a[href^="#"]').forEach(link => link.addEventListener('click', () => { const target = document.querySelector(link.getAttribute('href')); if (target) target.scrollIntoView({ behavior: 'smooth' }); }));
    </script>
  </body>
</html>
